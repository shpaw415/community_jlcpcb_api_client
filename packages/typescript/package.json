{
  "name": "@community-jlcpcb/client",
  "version": "0.1.0",
  "description": "JLCPCB OpenAPI client for browser, Node, and Workers.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shpaw415/community_jlcpcb_api_client",
    "directory": "packages/typescript"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "bun": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "bun run build"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
